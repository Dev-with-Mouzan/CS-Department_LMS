# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./gcb_lms.db
# For PostgreSQL, uncomment below and comment the SQLite line above:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=gcb_lms
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gcb_lms

# ── Backend / JWT ─────────────────────────────────────
SECRET_KEY=tplu7PzMEVulKAkongy94GnXmzw_mE0h3f71sgeFprJpkjzRYJbkPrpBham228RbYYVaQoBX2loLvxR5IUN28Q
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Uploads ──────────────────────────────────────
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=uploads
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,txt,zip,png,jpg,jpeg

# ── Default Admin (auto-created on first startup) ─────
ADMIN_EMAIL=admin@gcb.edu.pk
ADMIN_PASSWORD=Admin@123

# ── SMS OTP Provider: "fast2sms", "twilio", or "console" ─
SMS_PROVIDER=console

# ── Fast2SMS (https://www.fast2sms.com) ──────────────
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# ── Twilio (https://www.twilio.com) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
