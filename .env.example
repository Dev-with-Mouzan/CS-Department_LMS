# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gcb_lms

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gcb_lms
SECRET_KEY=your-secret-key-change-in-production

# SMS OTP provider: "fast2sms", "twilio", or "console" (dev print only)
SMS_PROVIDER=console

# Fast2SMS (https://www.fast2sms.com)
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=

# Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
